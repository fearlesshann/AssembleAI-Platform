{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "isolatedModules": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "baseUrl": ".", "paths": { "@assembleai/app-sdk": ["packages/app-sdk/src/index.ts"] }
  },
  "include": ["apps/**/*.ts", "apps/**/*.vue", "packages/**/*.ts", "tests/frontend/**/*.ts", "playwright.config.ts"]
}
