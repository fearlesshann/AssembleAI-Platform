{
  "name": "assembleai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": { "node": ">=24.18.0 <25", "npm": ">=11 <12" },
  "workspaces": ["apps/portal", "apps/sample/frontend", "apps/chatbi/frontend", "packages/app-sdk"],
  "scripts": {
    "dev": "npm run dev --workspace @assembleai/portal",
    "build": "npm run build --workspace @assembleai/sample && npm run build --workspace @assembleai/chatbi && npm run build --workspace @assembleai/portal",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "node tools/serve-frontend.mjs",
    "test": "node --test tests/frontend/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11"
  }
}
