<#ftl output_format="HTML" auto_esc=true>
<#-- Generated by tools/sync-reference-login.mjs; shared original login shell. -->
<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="same-origin" />
  <title>集智 · 登录工作台</title>
  <link rel="icon" type="image/png" href="${url.resourcesPath}/logo.png" />
  <script src="${url.resourcesPath}/theme-init.js"></script>
  <link rel="stylesheet" href="${url.resourcesPath}/login.css" />
</head>
<body>
  <div class="login-screen" id="loginScreen">
    <button class="theme-toggle login-theme-toggle" id="loginThemeToggle" type="button" aria-label="切换主题" title="切换主题">
      <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="3.25" stroke="currentColor" stroke-width="1.3"/>
        <path d="M8 1.5v1.4M8 13.1v1.4M1.5 8h1.4M13.1 8h1.4M3.05 3.05l.99.99M11.96 11.96l.99.99M12.95 3.05l-.99.99M4.04 11.96l-.99.99" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M12.6 9.35A5.25 5.25 0 0 1 6.65 3.4 5.5 5.5 0 1 0 12.6 9.35z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
      </svg>
    </button>

    <aside class="login-hero" aria-label="产品介绍">
      <div class="login-waves" id="loginWaves" aria-hidden="true">
        <canvas class="login-waves-canvas" id="loginWavesCanvas"></canvas>
      </div>
      <div class="login-hero-glow" aria-hidden="true"></div>

      <div class="login-hero-inner">
        <div class="login-brand">
          <img class="login-brand-mark" src="${url.resourcesPath}/logo.png" width="44" height="44" alt="" />
          <p class="login-brand-text">集智</p>
        </div>

        <div class="login-hero-copy">
          <h1 class="login-hero-title">让 AI 服务工厂的<em>每个</em>角落</h1>
          <p class="login-hero-sub">企业的唯一 AI 应用管理平台</p>
        </div>

        <div class="login-proof" aria-hidden="true">
          <div class="login-shot-deck">
            <figure class="login-shot is-back">
              <img src="${url.resourcesPath}/login-shot-admin.png" srcset="${url.resourcesPath}/login-shot-admin.png 2x" alt="" width="1000" height="680" decoding="async" draggable="false" />
            </figure>
            <figure class="login-shot is-mid">
              <img src="${url.resourcesPath}/login-shot-issues.png" srcset="${url.resourcesPath}/login-shot-issues.png 2x" alt="" width="1000" height="680" decoding="async" draggable="false" />
            </figure>
            <figure class="login-shot is-front">
              <img src="${url.resourcesPath}/login-shot-apps.png" srcset="${url.resourcesPath}/login-shot-apps.png 2x" alt="" width="1000" height="680" decoding="async" draggable="false" />
            </figure>
          </div>
        </div>

        <p class="login-hero-foot">企业 AI 应用平台 · 工厂协作 · RBAC</p>
      </div>
    </aside>

    <form class="login-card" id="loginForm" action="${url.loginAction}" method="post" novalidate>
      <canvas class="login-ether" id="loginEther" aria-hidden="true"></canvas>
      <div class="login-card-inner">
        <header class="login-form-heading">
          <p class="form-kicker">SECURE ENTRY</p>
          <h2 class="login-form-title"><span class="shiny-text" id="loginShinyTitle" style="--shiny-base:#b5b5b5;">找回密码</span></h2>
          <p class="login-form-desc">输入企业账号或邮箱。身份中心会发送密码重置邮件。</p>
        </header>

        <label class="login-field" for="loginAccount">
          <span class="login-label">账号 / 邮箱</span>
          <input class="login-input" id="loginAccount" name="username" value="${(auth.attemptedUsername!'')}" type="text" autocomplete="username" placeholder="name@factory.com" spellcheck="false" />
          <span class="login-field-error" data-error-for="account" hidden>请输入账号或邮箱</span>
        </label>


        <div class="login-row"><a class="login-link" id="backToLogin" href="${url.loginUrl}">返回登录</a></div>

        <p class="<#if message?? && message.type != "error">login-form-desc<#else>login-form-error</#if>" id="loginFormError" <#if !message??>hidden</#if> role="alert"><#if message??>${kcSanitize(message.summary)?no_esc}</#if></p>

        <button
          class="login-submit specular-button specular-button--lg"
          id="loginSubmit"
          type="submit"
          style="--sb-radius:12px;--sb-tint:var(--text-frame);--sb-tint-opacity:1;--sb-blur:0px;--sb-text-color:var(--frame-bg);"
        >
          <span class="specular-button__effect" id="loginSubmitEffect" aria-hidden="true"></span>
          <span class="specular-button__label">发送重置邮件</span>
        </button>

        <p class="login-security-note">加密会话 · 权限范围访问</p>
      </div>
    </form>
  </div>
  <script type="module" src="${url.resourcesPath}/login.js"></script>
</body>
</html>
