{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assembleai:application-manifest:1",
  "title": "AssembleAI application manifest write contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appId", "name", "version", "frontendEntry", "backendService", "permissions", "status", "frontendArtifact", "backendVersion", "category", "description"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "appId": { "$ref": "#/$defs/slug" },
    "name": { "allOf": [{ "$ref": "#/$defs/text" }], "minLength": 1, "maxLength": 128 },
    "version": { "$ref": "#/$defs/version" },
    "frontendEntry": {
      "type": "string", "maxLength": 136,
      "pattern": "^/apps/[a-z][a-z0-9-]{0,63}/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)/(?![\\s\\S])",
      "description": "Runtime additionally requires exact /apps/{appId}/{frontendArtifact.version}/ equality."
    },
    "backendService": { "$ref": "#/$defs/slug" },
    "permissions": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9:._-]{0,127}(?![\\s\\S])" }
    },
    "status": { "type": "string", "const": "draft" },
    "frontendArtifact": {
      "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}(?![\\s\\S])" }
      }
    },
    "backendVersion": { "$ref": "#/$defs/version" },
    "category": { "allOf": [{ "$ref": "#/$defs/text" }], "minLength": 1, "maxLength": 64 },
    "description": { "allOf": [{ "$ref": "#/$defs/text" }], "maxLength": 2000 }
  },
  "$defs": {
    "slug": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])" },
    "version": { "type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])" },
    "text": { "type": "string", "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?:\\S(?:[\\s\\S]*\\S)?)?(?![\\s\\S])" }
  }
}
